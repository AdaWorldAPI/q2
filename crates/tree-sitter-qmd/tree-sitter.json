{
  "metadata": {
    "version": "0.0.0",
    "license": "MIT",
    "authors": [
      {
        "name": "Posit, PBC"
      }
    ],
    "description": "Tree-sitter grammar for Quarto Markdown (.qmd). Originally derived from MDeiml's tree-sitter-markdown; developed independently since.",
    "links": {
      "repository": "https://github.com/quarto-dev/q2"
    }
  },
  "grammars": [
    {
      "name": "markdown",
      "scope": "text.markdown",
      "path": "tree-sitter-markdown",
      "injection-regex": "^(qmd|markdown|md)$",
      "file-types": [
        "qmd",
        "md"
      ],
      "highlights": "tree-sitter-markdown/queries/highlights.scm",
      "injections": "tree-sitter-markdown/queries/injections.scm",
      "external-files": [
        "common/common.js"
      ]
    }
  ]
}
